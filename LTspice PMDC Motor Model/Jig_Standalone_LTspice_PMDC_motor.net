V1 V_arm 0 PULSE(0 {Varm} 0 1p 1p {Tran_Time} {2*Tran_Time}) AC 1 0
X§X1 V_arm 0 O_spd Standalone_LTspice_PMDC_motor params: L_a=0.5 R_a=1 K_t=0.01 K_e=0.01 J=0.01 B=0.1

* block symbol definitions
.subckt Standalone_LTspice_PMDC_motor V_a+ V_a- Omega
R1 N001 V_a+ {R_a}
L1 N001 V_e {L_a} ic=0 Rser=0
E1 V_e V_a- Omega 0 {K_e}
H1 T_t 0 E1 {K_t}
B1 T_iner 0 V={J}*ddt(V(Omega))
E2 Omega 0 T_t T_iner {1/B}
.ends Standalone_LTspice_PMDC_motor

.param Tran_Time 25
.step param Varm list 1 5 10 24
.tran 0 {Tran_Time} 0 1e-5
.meas TRAN O_spd_end FIND V(O_spd) AT={Tran_Time}
.meas TRAN I_arm_end FIND -I(V1) AT={Tran_Time}
.meas TRAN BEMF_end FIND V(x1:V_e) AT={Tran_Time}
.meas TRAN Torque_end FIND V(x1:T_t) AT={Tran_Time}
.meas TRAN Inertia_end FIND V(x1:T_iner) AT={Tran_Time}
.backanno
.end
